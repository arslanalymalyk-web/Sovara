{
  "name": "rgs-portal-app",
  "private": true,
  "version": "0.0.0",
  "description": "RGS Client Portal, production application (Stage 0 foundations).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "sync:rbac": "node scripts/generate-rbac-data.mjs",
    "check": "npm run sync:rbac && git diff --exit-code src/lib/rbac/data.generated.ts && npm run typecheck && npm run lint && npm run test && npm run build",
    "db:migrate": "tsx scripts/migrate.ts",
    "build:migrate": "esbuild scripts/migrate.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/migrate.mjs --external:pg-native --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\" && node -e \"require('fs').cpSync('src/db/migrations','dist/migrations',{recursive:true})\""
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15",
    "next": "^16.4.4",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
