# Copy to .env for local development. Never commit real values; production values live in Azure Key Vault.
DATABASE_URL=postgres://rgs_app:change-me@localhost:5432/rgs_portal
# Staff sign-in (Microsoft Entra ID)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Customer sign-in (Microsoft Entra External ID)
ENTRA_EXTERNAL_TENANT_ID=
ENTRA_EXTERNAL_CLIENT_ID=
# Object storage (Azure Blob, Saudi Arabia region)
STORAGE_ACCOUNT_NAME=
STORAGE_CONTAINER=files
# Email (Azure Communication Services)
ACS_CONNECTION_STRING=
MAIL_FROM=
